# EventForge API URL (required)
# Get from: aws cloudformation describe-stacks --stack-name <stack> --query 'Stacks[0].Outputs[?OutputKey==`EventApiUrl`].OutputValue' --output text
VITE_EVENTFORGE_API_URL=

# CloudWatch Dashboard URL (optional)
# Format: https://console.aws.amazon.com/cloudwatch/home?region=<region>#dashboards:name=<stack>-monitoring
VITE_CLOUDWATCH_DASHBOARD_URL=

# SQS Queue URL (optional, for operations view)
# Get from: aws cloudformation describe-stacks --stack-name <stack> --query 'Stacks[0].Outputs[?OutputKey==`EventQueueUrl`].OutputValue' --output text
VITE_SQS_QUEUE_URL=

# SQS Dead Letter Queue URL (optional)
# Get from: aws cloudformation describe-stacks --stack-name <stack> --query 'Stacks[0].Outputs[?OutputKey==`EventDLQUrl`].OutputValue' --output text
VITE_SQS_DLQ_URL=

# DynamoDB Table Name (optional)
# Get from: aws cloudformation describe-stacks --stack-name <stack> --query 'Stacks[0].Outputs[?OutputKey==`EventStoreTableName`].OutputValue' --output text
VITE_DDB_TABLE_NAME=
